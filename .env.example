# --- Postgres ---
POSTGRES_USER=carma
POSTGRES_PASSWORD=carma
POSTGRES_DB=carma

# --- API ---
# Host/port used by the API to reach Postgres.
# In Docker Compose the host is the service name "db"; locally it is "localhost".
DATABASE_URL=postgres://carma:carma@localhost:5432/carma
API_PORT=3000

# --- Web ---
WEB_PORT=5173
# Where the Vite dev-server proxy forwards /api requests.
# Locally: http://localhost:3000  |  In Compose: http://api:3000
VITE_API_PROXY_TARGET=http://localhost:3000
